      "web_react_adapter": "1.1.0",
      "wordpress_adapter": "1.0.0"
    },
    "rules_checked": 17
  },
  "crate": {
    "name": "shruggie_insonic_egui",
    "edition": "2024",
    "rust_version": "1.95",
