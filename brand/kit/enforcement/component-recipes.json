{
  "$schema": "component-recipes.schema.json",
  "id": "shruggie-component-recipes",
  "kind": "component-recipe-catalog",
  "version": "1.1.0",
  "interface_canon_compatibility": ["1.0.0", "1.0.1"],
  "grammar": {
    "expresses": ["bounded-component-recipes"],
    "forbids": ["application-screens", "product-navigation", "route-trees", "renderer-property-bags", "raw-visual-values", "free-form-nesting"]
  },
  "required_dimensions": ["purpose", "element", "variants", "densities", "states", "roles", "keyboard", "target", "icons", "accessibility", "motion", "responsive", "overrides", "owner", "verification"],
  "components": {
    "AppFrame": {
      "purpose": "Own application-level environment boundaries and the root content frame.",
      "element": "application-shell",
      "variants": ["contained", "full-bleed"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "focus-visible"],
      "roles": {"background": "$role.surface.background", "foreground": "$role.text.primary", "gutter_compact": "$role.layout.gutter.compact", "gutter_expanded": "$role.layout.gutter.expanded"},
      "keyboard": ["Tab follows document order within the global focus boundary", "Skip link moves focus to main content"],
      "target": {"interactive": false, "minimum": 0},
      "icons": {"policy": "optional", "accessible_name": "inherited-from-control"},
      "accessibility": {"role": "application-landmarks", "name": "landmarks", "focus": "global-boundary", "relationships": ["header-main-overlay"]},
      "motion": {"standard": "$role.motion.standard", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["viewport", "safe_area", "window_class", "text_scale", "ime_obstruction", "titlebar_regions"], "compact": "single-column", "expanded": "bounded-content"},
      "overrides": ["roles.background"],
      "owner": "app-frame",
      "verification": ["app-frame-single-owner", "app-frame-focus-boundary", "app-frame-ime-reachability"]
    },
    "Button": {
      "purpose": "Trigger one named action.",
      "element": "button",
      "variants": ["primary", "secondary", "ghost", "destructive"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "loading"],
      "roles": {"fill": "$role.action.primary", "foreground": "$role.text.on_action", "focus": "$role.focus.ring", "destructive": "$role.action.destructive", "destructive_foreground": "$role.text.on_destructive"},
      "keyboard": ["Enter activates", "Space activates"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "visible-label"},
      "accessibility": {"role": "button", "name": "required-visible-or-aria", "focus": "self", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["pointer_precision", "hover", "text_scale"], "compact": "wrap-label", "expanded": "intrinsic"},
      "overrides": ["roles.fill"],
      "owner": "server",
      "verification": ["button-keyboard", "button-loading-name", "control-target"]
    },
    "IconButton": {
      "purpose": "Trigger one named action represented visually by an icon.",
      "element": "button",
      "variants": ["primary", "secondary", "ghost", "destructive"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "loading"],
      "roles": {"fill": "$role.action.primary", "foreground": "$role.text.on_action", "focus": "$role.focus.ring", "destructive": "$role.action.destructive", "destructive_foreground": "$role.text.on_destructive"},
      "keyboard": ["Enter activates", "Space activates"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "required", "accessible_name": "required-on-control"},
      "accessibility": {"role": "button", "name": "required", "focus": "self", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["pointer_precision", "hover"], "compact": "minimum-target", "expanded": "minimum-target"},
      "overrides": ["roles.fill"],
      "owner": "server",
      "verification": ["icon-button-name", "icon-decorative", "control-target"]
    },
    "Toolbar": {
      "purpose": "Group a bounded set of related controls with roving focus.",
      "element": "toolbar",
      "variants": ["horizontal", "vertical"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"],
      "roles": {"surface": "$role.surface.card", "foreground": "$role.text.primary", "border": "$role.border.default", "focus": "$role.focus.ring"},
      "keyboard": ["Arrow keys move between enabled controls", "Home moves to first control", "End moves to last control"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "per-control"},
      "accessibility": {"role": "toolbar", "name": "required", "focus": "roving", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "pointer_precision", "hover"], "compact": "overflow-scroll", "expanded": "intrinsic"},
      "overrides": ["roles.surface"],
      "owner": "client",
      "verification": ["toolbar-roving-focus", "toolbar-orientation", "control-target"]
    },
    "Tabs": {
      "purpose": "Switch among a bounded set of peer panels.",
      "element": "tablist",
      "variants": ["automatic", "manual"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"],
      "roles": {"surface": "$role.surface.card", "foreground": "$role.text.primary", "muted": "$role.text.muted", "selected": "$role.action.primary", "focus": "$role.focus.ring"},
      "keyboard": ["Arrow keys move between tabs", "Home selects first tab", "End selects last tab", "Enter or Space activates in manual mode"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "visible-label"},
      "accessibility": {"role": "tabs", "name": "tablist-required", "focus": "roving", "relationships": ["tab-controls-panel", "panel-labelledby-tab"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "pointer_precision", "hover"], "compact": "horizontal-scroll", "expanded": "intrinsic"},
      "overrides": ["roles.selected"],
      "owner": "client",
      "verification": ["tabs-keyboard", "tabs-relationships", "tabs-selected-focus"]
    },
    "Menu": {
      "purpose": "Expose a temporary list of named actions.",
      "element": "menu",
      "variants": ["dropdown"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"],
      "roles": {"surface": "$role.surface.overlay", "foreground": "$role.text.primary", "muted": "$role.text.muted", "focus": "$role.focus.ring"},
      "keyboard": ["Arrow keys move through items", "Home and End move to boundaries", "Typeahead moves to matching item", "Escape closes and returns focus"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "item-label"},
      "accessibility": {"role": "menu", "name": "trigger-required", "focus": "contained-roving", "relationships": ["trigger-controls-menu"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["viewport", "pointer_precision", "touch", "ime_obstruction"], "compact": "viewport-contained", "expanded": "anchor-contained"},
      "overrides": ["roles.surface"],
      "owner": "client",
      "verification": ["menu-keyboard", "menu-typeahead", "menu-focus-return"]
    },
    "Dialog": {
      "purpose": "Present a modal task with explicit title and dismissal.",
      "element": "dialog",
      "variants": ["modal", "alert"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "focus-visible", "loading", "invalid", "warning", "success"],
      "roles": {"surface": "$role.surface.overlay", "foreground": "$role.text.primary", "muted": "$role.text.muted", "focus": "$role.focus.ring"},
      "keyboard": ["Tab remains within the dialog", "Escape dismisses when allowed", "Close returns focus to trigger"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "close-control-required"},
      "accessibility": {"role": "dialog", "name": "title-required", "focus": "trapped-and-returned", "relationships": ["dialog-labelledby-title", "dialog-describedby-description"]},
      "motion": {"standard": "$role.motion.standard", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["viewport", "window_class", "text_scale", "ime_obstruction"], "compact": "edge-contained", "expanded": "centered"},
      "overrides": ["roles.surface"],
      "owner": "client",
      "verification": ["dialog-focus-trap", "dialog-name", "dialog-focus-return"]
    },
    "Field": {
      "purpose": "Associate a visible label, description, validation message, and control.",
      "element": "field-group",
      "variants": ["stacked", "inline"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "focus-visible", "disabled", "invalid", "warning", "success"],
      "roles": {"foreground": "$role.text.primary", "muted": "$role.text.muted", "invalid": "$role.action.destructive", "focus": "$role.focus.ring"},
      "keyboard": ["Label activation focuses the associated control"],
      "target": {"interactive": false, "minimum": 0},
      "icons": {"policy": "optional", "accessible_name": "status-text-required"},
      "accessibility": {"role": "group", "name": "visible-label-required", "focus": "delegated-to-control", "relationships": ["label-for-control", "control-describedby-message"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "text_scale"], "compact": "stacked", "expanded": "configured"},
      "overrides": [],
      "owner": "server",
      "verification": ["field-label", "field-description", "field-error-association"]
    },
    "FormControls": {
      "purpose": "Collect native text, choice, and selection input.",
      "element": "native-form-controls",
      "variants": ["input", "textarea", "select", "checkbox", "radio"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "invalid", "warning", "success"],
      "roles": {"surface": "$role.surface.background", "foreground": "$role.text.primary", "border": "$role.border.default", "invalid": "$role.action.destructive", "focus": "$role.focus.ring"},
      "keyboard": ["Native control keyboard behavior is preserved", "Space toggles checkbox and radio controls"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "not-name-source"},
      "accessibility": {"role": "native", "name": "field-label-required", "focus": "self", "relationships": ["field-owned"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["pointer_precision", "touch", "text_scale"], "compact": "full-width", "expanded": "configured"},
      "overrides": ["roles.surface"],
      "owner": "server",
      "verification": ["form-native-semantics", "form-invalid-state", "control-target"]
    },
    "ListRow": {
      "purpose": "Present one item with distinct selection and activation semantics.",
      "element": "list-item",
      "variants": ["static", "action", "selection"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"],
      "roles": {"surface": "$role.surface.card", "foreground": "$role.text.primary", "muted": "$role.text.muted", "selected": "$role.action.primary"},
      "keyboard": ["Native link or button activation is preserved", "Selection and activation remain distinct"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "row-label"},
      "accessibility": {"role": "listitem", "name": "row-label-required", "focus": "single-action-only", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "text_scale"], "compact": "wrap-metadata", "expanded": "columns"},
      "overrides": ["roles.surface"],
      "owner": "server",
      "verification": ["list-row-selection", "list-row-no-nested-actions", "control-target"]
    },
    "SplitPane": {
      "purpose": "Resize two peer regions through an accessible separator.",
      "element": "separator",
      "variants": ["horizontal", "vertical"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled"],
      "roles": {"surface": "$role.surface.background", "divider": "$role.border.strong", "focus": "$role.focus.ring"},
      "keyboard": ["Arrow keys resize by one step", "Home moves to minimum", "End moves to maximum"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "prohibited", "accessible_name": "separator-label-required"},
      "accessibility": {"role": "separator", "name": "required", "focus": "self", "relationships": ["separator-controls-primary-pane"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["viewport", "window_class", "pointer_precision", "touch"], "compact": "stacked-or-clamped", "expanded": "resizable"},
      "overrides": ["roles.divider"],
      "owner": "client",
      "verification": ["split-pane-keyboard", "split-pane-pointer", "split-pane-clamping"]
    },
    "Toast": {
      "purpose": "Announce a non-blocking status with optional dismissal.",
      "element": "status",
      "variants": ["status", "warning", "error"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "focus-visible", "warning", "success"],
      "roles": {"surface": "$role.surface.overlay", "foreground": "$role.text.primary", "warning": "$role.action.emphasis", "error": "$role.action.destructive"},
      "keyboard": ["Tab reaches persistent actions", "Escape dismisses when allowed", "Focus pauses timeout"],
      "target": {"interactive": true, "minimum": 44},
      "icons": {"policy": "optional", "accessible_name": "status-text-required"},
      "accessibility": {"role": "status-or-alert", "name": "message-required", "focus": "action-only", "relationships": ["viewport-owned-by-app-frame"]},
      "motion": {"standard": "$role.motion.standard", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["viewport", "safe_area", "reduced_motion", "ime_obstruction"], "compact": "edge-contained", "expanded": "corner-contained"},
      "overrides": ["roles.surface"],
      "owner": "client",
      "verification": ["toast-announcement", "toast-focus-pause", "toast-reduced-motion"]
    },
    "StatusBadge": {
      "purpose": "Communicate status with text or icon in addition to color.",
      "element": "status-text",
      "variants": ["neutral", "success", "warning", "error"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "warning", "success"],
      "roles": {"foreground": "$role.text.primary", "muted": "$role.text.muted", "warning": "$role.action.emphasis", "error": "$role.action.destructive"},
      "keyboard": ["No special keyboard interaction"],
      "target": {"interactive": false, "minimum": 0},
      "icons": {"policy": "optional", "accessible_name": "visible-status-text"},
      "accessibility": {"role": "status-text", "name": "visible-text-required", "focus": "none", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["forced_colors", "text_scale"], "compact": "wrap", "expanded": "intrinsic"},
      "overrides": [],
      "owner": "server",
      "verification": ["status-non-color-cue", "status-forced-colors"]
    },
    "Card": {
      "purpose": "Group related content without implying whole-card activation.",
      "element": "article-or-section",
      "variants": ["plain", "outlined", "elevated"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "hover", "focus-visible", "selected"],
      "roles": {"surface": "$role.surface.card", "foreground": "$role.text.primary", "border": "$role.border.default"},
      "keyboard": ["Nested native controls remain independent"],
      "target": {"interactive": false, "minimum": 0},
      "icons": {"policy": "optional", "accessible_name": "content-owned"},
      "accessibility": {"role": "article-or-section", "name": "heading-when-needed", "focus": "nested-controls", "relationships": []},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "text_scale"], "compact": "full-width", "expanded": "intrinsic"},
      "overrides": ["roles.surface"],
      "owner": "server",
      "verification": ["card-no-giant-button", "card-heading"]
    },
    "EmptyState": {
      "purpose": "Explain an empty collection and offer at most one primary recovery action.",
      "element": "section",
      "variants": ["informational", "actionable"],
      "densities": ["comfortable", "compact"],
      "states": ["default", "focus-visible", "loading"],
      "roles": {"foreground": "$role.text.primary", "muted": "$role.text.muted", "action": "$role.action.primary"},
      "keyboard": ["Action uses native button or link behavior"],
      "target": {"interactive": false, "minimum": 0},
      "icons": {"policy": "optional", "accessible_name": "decorative-unless-informative"},
      "accessibility": {"role": "section", "name": "heading-required", "focus": "action-only", "relationships": ["section-labelledby-heading"]},
      "motion": {"standard": "$role.motion.fast", "reduced": "$role.motion.reduced"},
      "responsive": {"inputs": ["window_class", "text_scale"], "compact": "stacked", "expanded": "bounded"},
      "overrides": [],
      "owner": "server",
      "verification": ["empty-state-heading", "empty-state-action"]
    }
  },
  "app_frame_profiles": [
    {
      "profile": "browser",
      "responsibilities": {"safe_area": "app-frame", "dynamic_viewport": "app-frame", "root_scrolling": "app-frame", "fixed_chrome": "app-frame", "ime_obstruction": "app-frame", "titlebar_regions": "app-frame", "global_focus": "app-frame"},
      "handoff": {},
      "capabilities": ["viewport", "safe_area", "window_class", "pointer_precision", "hover", "hardware_keyboard", "touch", "text_scale", "reduced_motion", "forced_colors", "theme", "ime_obstruction", "titlebar_regions"]
    },
    {
      "profile": "tauri",
      "responsibilities": {"safe_area": "app-frame", "dynamic_viewport": "app-frame", "root_scrolling": "app-frame", "fixed_chrome": "app-frame", "ime_obstruction": "app-frame", "titlebar_regions": "host", "global_focus": "app-frame"},
      "handoff": {"titlebar_regions": "--bb-host-titlebar-block-end"},
      "capabilities": ["viewport", "safe_area", "window_class", "pointer_precision", "hover", "hardware_keyboard", "touch", "text_scale", "reduced_motion", "forced_colors", "theme", "ime_obstruction", "titlebar_regions"]
    },
    {
      "profile": "wails",
      "responsibilities": {"safe_area": "app-frame", "dynamic_viewport": "app-frame", "root_scrolling": "app-frame", "fixed_chrome": "app-frame", "ime_obstruction": "app-frame", "titlebar_regions": "host", "global_focus": "app-frame"},
      "handoff": {"titlebar_regions": "--bb-host-titlebar-block-end"},
      "capabilities": ["viewport", "safe_area", "window_class", "pointer_precision", "hover", "hardware_keyboard", "touch", "text_scale", "reduced_motion", "forced_colors", "theme", "ime_obstruction", "titlebar_regions"]
    }
  ],
  "coverage": [
    {"component": "AppFrame", "need": "application shell", "states": ["default", "focus-visible"], "adapters": ["web-react"], "verification": ["app-frame-single-owner"]},
    {"component": "Button", "need": "named action", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "loading"], "adapters": ["web-react"], "verification": ["button-keyboard"]},
    {"component": "IconButton", "need": "icon action", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "loading"], "adapters": ["web-react"], "verification": ["icon-button-name"]},
    {"component": "Toolbar", "need": "grouped controls", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"], "adapters": ["web-react"], "verification": ["toolbar-roving-focus"]},
    {"component": "Tabs", "need": "peer panels", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"], "adapters": ["web-react"], "verification": ["tabs-keyboard"]},
    {"component": "Menu", "need": "temporary actions", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"], "adapters": ["web-react"], "verification": ["menu-keyboard"]},
    {"component": "Dialog", "need": "modal task", "states": ["default", "focus-visible", "loading", "invalid", "warning", "success"], "adapters": ["web-react"], "verification": ["dialog-focus-trap"]},
    {"component": "Field", "need": "form relationships", "states": ["default", "focus-visible", "disabled", "invalid", "warning", "success"], "adapters": ["web-react"], "verification": ["field-label"]},
    {"component": "FormControls", "need": "native input", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "invalid", "warning", "success"], "adapters": ["web-react"], "verification": ["form-native-semantics"]},
    {"component": "ListRow", "need": "list item", "states": ["default", "hover", "pressed", "focus-visible", "disabled", "selected"], "adapters": ["web-react"], "verification": ["list-row-selection"]},
    {"component": "SplitPane", "need": "resizable regions", "states": ["default", "hover", "pressed", "focus-visible", "disabled"], "adapters": ["web-react"], "verification": ["split-pane-keyboard"]},
    {"component": "Toast", "need": "non-blocking status", "states": ["default", "hover", "focus-visible", "warning", "success"], "adapters": ["web-react"], "verification": ["toast-announcement"]},
    {"component": "StatusBadge", "need": "inline status", "states": ["default", "warning", "success"], "adapters": ["web-react"], "verification": ["status-non-color-cue"]},
    {"component": "Card", "need": "content grouping", "states": ["default", "hover", "focus-visible", "selected"], "adapters": ["web-react"], "verification": ["card-no-giant-button"]},
    {"component": "EmptyState", "need": "empty collection", "states": ["default", "focus-visible", "loading"], "adapters": ["web-react"], "verification": ["empty-state-heading"]}
  ]
}
