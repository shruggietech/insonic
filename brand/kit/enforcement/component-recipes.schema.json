{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand.shruggie.tech/schemas/component-recipes-1.json",
  "title": "BrandBuilder Component Recipe Catalog",
  "type": "object",
  "required": ["$schema", "id", "kind", "version", "interface_canon_compatibility", "grammar", "required_dimensions", "components", "app_frame_profiles", "coverage"],
  "properties": {
    "$schema": {"const": "component-recipes.schema.json"},
    "id": {"const": "shruggie-component-recipes"},
    "kind": {"const": "component-recipe-catalog"},
    "version": {"$ref": "#/$defs/semver"},
    "interface_canon_compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/semver"}
    },
    "grammar": {
      "type": "object",
      "required": ["expresses", "forbids"],
      "properties": {
        "expresses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "required_dimensions": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "components": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "additionalProperties": {"$ref": "#/$defs/recipe"}
    },
    "app_frame_profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/profile"}
    },
    "coverage": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["component", "need", "states", "adapters", "verification"],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "recipe": {
      "type": "object",
      "required": ["purpose", "element", "variants", "densities", "states", "roles", "keyboard", "target", "icons", "accessibility", "motion", "responsive", "overrides", "owner", "verification"],
      "properties": {
        "keyboard": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["profile", "responsibilities", "handoff", "capabilities"],
      "properties": {
        "profile": {"enum": ["browser", "tauri", "wails"]},
        "responsibilities": {"type": "object"},
        "handoff": {"type": "object"},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
