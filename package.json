{
  "name": "insonic",
  "version": "0.0.0",
  "private": true,
  "description": "insonic repository foundation and maintainer tools",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/check-schemas.mjs",
    "schemas:check": "node scripts/check-schemas.mjs",
    "test": "node --test tests/*.test.mjs",
    "brand:check": "node scripts/sync-brand-kit.mjs --check",
    "brand:update": "node scripts/sync-brand-kit.mjs --update",
    "brand:verify": "node scripts/sync-brand-kit.mjs --verify",
    "github:check": "node scripts/github-bootstrap.mjs --check",
    "github:apply": "node scripts/github-bootstrap.mjs --apply"
  }
}
