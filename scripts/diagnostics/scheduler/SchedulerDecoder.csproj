<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.EventTracing.Cpu" Version="[1.12.10]" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Metadata" Version="[1.12.10]" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.OutputRedirection" Version="[1.12.10]" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.Toolkit" Version="[1.11.0]" />
  </ItemGroup>
</Project>
