                  "product_code",
                  "upgrade_code",
                  "version",
                  "sha256",
                  "size_bytes"
                ],
                "additionalProperties": false,
                "description": "Bounded full MSI identity, independently compared with the MSI asset."
              },
              "manifest": {
                "const": "asInvoker",
                "description": "Explicit same-user Windows execution level."
              },
              "scope": {
                "const": "per-user",
                "description": "Same ordinary invoking account."
              },
              "signing": {
                "type": "object",
                "properties": {
                  "configured": {
                    "const": false,
                    "description": "No signing identity is configured."
                  },
                  "verified": {
                    "const": false,
                    "description": "No publisher signature is asserted."
                  },
                  "status": {
                    "const": "unconfigured",
                    "description": "Newly authored unsigned setup artifact."
                  }
                },
                "required": [
                  "configured",
                  "verified",
                  "status"
                ],
                "additionalProperties": false,
                "description": "Setup signing is independently unconfigured."
              },
              "qualification": {
                "type": "object",
                "properties": {
