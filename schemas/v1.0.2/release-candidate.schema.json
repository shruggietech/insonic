                    "type": "string",
                    "description": "Embedded per-user MSI ProductCode."
                  },
                  "upgrade_code": {
                    "const": "{96D72489-3629-52FB-A30D-79CCD4CAE9BC}",
                    "description": "Production per-user MSI product family."
                  },
                  "version": {
                    "const": "1.0.2",
                    "description": "Embedded MSI release version."
                  },
                  "sha256": {
                    "$ref": "common.schema.json#/$defs/sha256",
                    "description": "Exact complete embedded MSI digest."
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Full embedded MSI byte length."
                  }
