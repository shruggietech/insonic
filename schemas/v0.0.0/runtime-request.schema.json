{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shruggietech/insonic/v0.0.0/schemas/v0.0.0/runtime-request.schema.json",
  "title": "Runtime request",
  "description": "A bounded local runtime operation correlated to a workspace and request. Job operations use durable catalog attempts and idempotent acceptance.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "workspace_id",
    "request_id",
    "operation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.0.0",
      "description": "Shared software and contract version."
    },
    "kind": {
      "const": "runtime-request",
      "description": "Master-registry document discriminator."
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Workspace authority receiving the operation."
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Client-generated correlation identifier."
    },
    "operation": {
      "enum": [
        "workspace.show",
        "doctor",
        "catalog.show",
        "jobs.start",
        "jobs.show",
        "jobs.cancel",
        "jobs.retry",
        "jobs.history",
        "artifacts.publish",
        "artifacts.show",
        "artifacts.verify",
        "artifacts.materialize",
        "artifacts.reconcile",
        "artifacts.abort",
        "artifacts.retire",
        "artifacts.lease-renew",
        "artifacts.lease-release",
        "artifacts.retain",
        "artifacts.release-reference",
        "artifacts.cache-prune",
        "media.import",
        "media.list",
        "media.show",
        "media.metadata",
        "media.raw",
        "media.refresh",
        "media.set-origin",
        "media.relocate",
        "models.register",
        "models.acquire",
        "models.list",
        "models.show",
        "models.verify",
        "models.materialize",
        "work.list",
        "work.show",
        "work.cancel",
        "work.retry",
        "credentials.select",
        "credentials.add",
        "credentials.replace",
        "credentials.delete",
        "credentials.status",
        "credentials.unlock",
        "credentials.load",
        "work.results",
        "recordings.process",
        "recordings.assemble",
        "recordings.show",
        "recordings.document",
        "recordings.mappings",
        "recordings.map-speaker",
        "recordings.export",
        "recordings.resolve-segment"
      ],
      "description": "Shared operation selected by either client."
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Durable job identity to inspect, view history, cancel or retry."
    },
    "after_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Exclusive attempt generation cursor for bounded job history pages."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "description": "Bounded qualification attempt duration in integer milliseconds."
    },
    "publication_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Artifact publication identity scoped to this workspace."
    },
    "lease_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Renewable materialization lease identity."
    },
    "reference_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Durable retention reference identity."
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit local source file streamed privately by the shared runtime."
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Nonsecret artifact role recorded with its immutable content identity."
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Explicit materialization byte ceiling overriding the default 10 GiB cache admission bound."
    },
    "item_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Workspace-scoped media, model or real-work identifier."
    },
    "data": {
      "type": "object",
      "description": "Operation-specific input; credential input is transient current-user IPC and is never journaled."
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "operation": {
              "const": "jobs.history",
              "description": "History operation accepting a generation cursor."
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "after_generation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "jobs.start",
            "description": "Start operation discriminator."
          }
        }
      },
      "then": {
        "required": [
          "duration_ms"
        ],
        "not": {
          "required": [
            "job_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "jobs.show",
              "jobs.cancel",
              "jobs.retry",
              "jobs.history"
            ],
            "description": "Existing attempt operation discriminator."
          }
        }
      },
      "then": {
        "required": [
          "job_id"
        ],
        "not": {
          "required": [
            "duration_ms"
          ]
        }
      }
    },
    {
