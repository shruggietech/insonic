            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Current catalog revision for compare-and-swap."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "New local reference path with unchanged digest and size."
              }
            },
            "description": "Typed input for the selected operation."
          }
        }
