            "properties": {
              "after_ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "description": "Inclusive first result ordinal, default0."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Maximum entries, default100."
              }
            }
          }
        }
