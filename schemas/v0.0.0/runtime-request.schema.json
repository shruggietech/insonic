        },
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "arguments"
            ],
            "additionalProperties": false,
            "properties": {
              "arguments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string"
                },
                "description": "Credential operation and optional nonsecret identifier or backend."
              },
              "input": {
                "type": "object",
                "description": "Bounded transient value/passphrase/session envelope from protected stdin.",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "description": "Credential value kept outside public contracts and journals.",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "passphrase": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "Vault passphrase kept in current runtime memory."
                  },
                  "session": {
                    "type": "object",
                    "description": "Explicit transient UUID-keyed credential mapping.",
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "description": "Typed input for the selected operation."
          }
