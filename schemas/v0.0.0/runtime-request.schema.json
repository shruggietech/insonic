{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shruggietech/insonic/v0.0.0/schemas/v0.0.0/runtime-request.schema.json",
  "title": "Runtime request",
  "description": "A bounded local runtime operation correlated to a workspace and request. Job operations use durable catalog attempts and idempotent acceptance.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "workspace_id",
    "request_id",
    "operation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.0.0",
      "description": "Shared software and contract version."
    },
    "kind": {
      "const": "runtime-request",
      "description": "Master-registry document discriminator."
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Workspace authority receiving the operation."
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Client-generated correlation identifier."
    },
    "operation": {
      "enum": [
        "workspace.show",
        "doctor",
        "catalog.show",
        "jobs.start",
        "jobs.show",
        "jobs.cancel",
        "jobs.retry",
        "jobs.history",
        "artifacts.publish",
        "artifacts.show",
        "artifacts.verify",
        "artifacts.materialize",
        "artifacts.reconcile",
        "artifacts.abort",
        "artifacts.retire",
        "artifacts.lease-renew",
        "artifacts.lease-release",
        "artifacts.retain",
        "artifacts.release-reference",
        "artifacts.cache-prune",
        "media.import",
        "media.list",
        "media.show",
        "media.metadata",
        "media.raw",
        "media.refresh",
        "media.set-origin",
        "media.relocate",
        "models.register",
        "models.acquire",
        "models.list",
        "models.show",
        "models.verify",
        "models.materialize",
        "work.list",
        "work.show",
        "work.cancel",
        "work.retry",
        "credentials.select",
        "credentials.add",
        "credentials.replace",
        "credentials.delete",
        "credentials.status",
        "credentials.unlock",
        "credentials.load",
        "work.results"
      ],
      "description": "Shared operation selected by either client."
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Durable job identity to inspect, view history, cancel or retry."
    },
    "after_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Exclusive attempt generation cursor for bounded job history pages."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "description": "Bounded qualification attempt duration in integer milliseconds."
    },
    "publication_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Artifact publication identity scoped to this workspace."
    },
    "lease_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Renewable materialization lease identity."
    },
    "reference_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Durable retention reference identity."
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit local source file streamed privately by the shared runtime."
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Nonsecret artifact role recorded with its immutable content identity."
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Explicit materialization byte ceiling overriding the default 10 GiB cache admission bound."
    },
    "item_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Workspace-scoped media, model or real-work identifier."
    },
    "data": {
      "type": "object",
      "description": "Operation-specific input; credential input is transient current-user IPC and is never journaled."
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "operation": {
              "const": "jobs.history",
              "description": "History operation accepting a generation cursor."
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "after_generation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "jobs.start",
            "description": "Start operation discriminator."
          }
        }
      },
      "then": {
        "required": [
          "duration_ms"
        ],
        "not": {
          "required": [
            "job_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "jobs.show",
              "jobs.cancel",
              "jobs.retry",
              "jobs.history"
            ],
            "description": "Existing attempt operation discriminator."
          }
        }
      },
      "then": {
        "required": [
          "job_id"
        ],
        "not": {
          "required": [
            "duration_ms"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "workspace.show",
              "doctor",
              "catalog.show"
            ],
            "description": "Workspace inspection operation discriminator."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "workspace.show",
              "doctor",
              "catalog.show",
              "jobs.start",
              "jobs.show",
              "jobs.cancel",
              "jobs.retry",
              "jobs.history"
            ],
            "description": "Operation family selecting its exact artifact argument layout."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "publication_id"
              ]
            },
            {
              "required": [
                "source_path"
              ]
            },
            {
              "required": [
                "artifact_kind"
              ]
            },
            {
              "required": [
                "lease_id"
              ]
            },
            {
              "required": [
                "reference_id"
              ]
            },
            {
              "required": [
                "max_bytes"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "artifacts.publish"
            ],
            "description": "Operation family selecting its exact artifact argument layout."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "publication_id"
              ]
            },
            {
              "required": [
                "lease_id"
              ]
            },
            {
              "required": [
                "reference_id"
              ]
            },
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            },
            {
              "required": [
                "after_generation"
              ]
            },
            {
              "required": [
                "max_bytes"
              ]
            }
          ]
        },
        "required": [
          "source_path",
          "artifact_kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "artifacts.lease-renew",
              "artifacts.lease-release"
            ],
            "description": "Operation family selecting its exact artifact argument layout."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source_path"
              ]
            },
            {
              "required": [
                "artifact_kind"
              ]
            },
            {
              "required": [
                "reference_id"
              ]
            },
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            },
            {
              "required": [
                "after_generation"
              ]
            },
            {
              "required": [
                "max_bytes"
              ]
            }
          ]
        },
        "required": [
          "publication_id",
          "lease_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "artifacts.retain",
              "artifacts.release-reference"
            ],
            "description": "Operation family selecting its exact artifact argument layout."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source_path"
              ]
            },
            {
              "required": [
                "artifact_kind"
              ]
            },
            {
              "required": [
                "lease_id"
              ]
            },
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            },
            {
              "required": [
                "after_generation"
              ]
            },
            {
              "required": [
                "max_bytes"
              ]
            }
          ]
        },
        "required": [
          "publication_id",
          "reference_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "artifacts.show",
              "artifacts.verify",
              "artifacts.materialize",
              "artifacts.reconcile",
              "artifacts.abort",
              "artifacts.retire",
              "artifacts.cache-prune"
            ],
            "description": "Operation family selecting its exact artifact argument layout."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source_path"
              ]
            },
            {
              "required": [
                "artifact_kind"
              ]
            },
            {
              "required": [
                "lease_id"
              ]
            },
            {
              "required": [
                "reference_id"
              ]
            },
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            },
            {
              "required": [
                "after_generation"
              ]
            }
          ]
        },
        "required": [
          "publication_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "not": {
              "const": "artifacts.materialize"
            },
            "description": "Only materialization accepts a cache size override."
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "max_bytes"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "workspace.show",
              "doctor",
              "catalog.show",
              "jobs.start",
              "jobs.show",
              "jobs.cancel",
              "jobs.retry",
              "jobs.history",
              "artifacts.publish",
              "artifacts.show",
              "artifacts.verify",
              "artifacts.materialize",
              "artifacts.reconcile",
              "artifacts.abort",
              "artifacts.retire",
              "artifacts.lease-renew",
              "artifacts.lease-release",
              "artifacts.retain",
              "artifacts.release-reference",
              "artifacts.cache-prune"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "item_id"
              ]
            },
            {
              "required": [
                "data"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.import",
              "media.list",
              "media.show",
              "media.metadata",
              "media.raw",
              "media.refresh",
              "media.set-origin",
              "media.relocate",
              "models.register",
              "models.acquire",
              "models.list",
              "models.show",
              "models.verify",
              "models.materialize",
              "work.list",
              "work.show",
              "work.cancel",
              "work.retry",
              "credentials.select",
              "credentials.add",
              "credentials.replace",
              "credentials.delete",
              "credentials.status",
              "credentials.unlock",
              "credentials.load"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "duration_ms"
              ]
            },
            {
              "required": [
                "after_generation"
              ]
            },
            {
              "required": [
                "publication_id"
              ]
            },
            {
              "required": [
                "source_path"
              ]
            },
            {
              "required": [
                "artifact_kind"
              ]
            },
            {
              "required": [
                "lease_id"
              ]
            },
            {
              "required": [
                "reference_id"
              ]
            },
            {
              "required": [
                "max_bytes"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.list",
              "models.list",
              "work.list"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "item_id"
          ]
        },
        "properties": {
          "data": {
            "type": "object",
            "description": "Bounded current-state list page.",
            "additionalProperties": false,
            "properties": {
              "after_id": {
                "$ref": "common.schema.json#/$defs/uuid",
                "description": "Exclusive lexically ordered UUID cursor."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Maximum entries, default100."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.show",
              "media.metadata",
              "media.raw",
              "models.show",
              "models.verify",
              "models.materialize",
              "work.show",
              "work.cancel",
              "work.retry"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "required": [
          "item_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "data"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.import"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "item_id"
              ]
            }
          ]
        },
        "properties": {
          "data": {
            "$ref": "import-manifest.schema.json",
            "description": "Typed input for the selected operation."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "models.register",
              "models.acquire"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "item_id"
              ]
            }
          ]
        },
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "manifest"
            ],
            "additionalProperties": false,
            "properties": {
              "manifest": {
                "$ref": "base-model-manifest.schema.json",
                "description": "Exact downloaded base-model identity and file contract."
              }
            },
            "description": "Typed input for the selected operation."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.refresh"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "required": [
          "item_id",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "import-manifest.schema.json#/properties/defaults",
            "description": "Typed input for the selected operation."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "media.set-origin"
            ],
            "description": "Operation family with an exact argument shape."
          }
        }
      },
      "then": {
        "required": [
          "item_id",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "revision",
              "options"
            ],
            "additionalProperties": false,
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Current catalog revision for compare-and-swap."
              },
              "options": {
                "$ref": "import-manifest.schema.json#/properties/defaults",
                "description": "Owner date and timezone selection."
              }
            },
            "description": "Typed input for the selected operation."
          }
        }
      }
    },
    {
      "if": {
